<?xml version="1.0" encoding="utf-8"?>
<!-- Match SignPath project artifact config 'initial' for Inno Setup installer.
     CI uploads unsigned .exe as ZIP → SignPath signs all PE files inside. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="*.exe" />
      <include path="*.dll" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
