#include <windows.h>
#include <commctrl.h>
#include "resource.h"

#ifndef IDC_STATIC
#define IDC_STATIC (-1)
#endif

IDI_APP_ICON    ICON    "icons/gotiengviet.ico"
IDI_TRAY_V      ICON    "icons/tray_v.ico"
IDI_TRAY_E      ICON    "icons/tray_e.ico"

IDD_SETUP_DIALOG DIALOGEX 0, 0, 240, 160
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GoTiengViet - Cài đặt"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Kiểu gõ", IDC_STATIC, 10, 10, 220, 45
    AUTORADIOBUTTON "Telex (gõ lặp: aa -> â, s/f/r/x/j)", IDC_RADIO_TELEX, 20, 24, 190, 10, WS_GROUP
    AUTORADIOBUTTON "VNI (số: 1->sắc, 2->huyền, 6->mũ...)", IDC_RADIO_VNI, 20, 38, 190, 10

    GROUPBOX        "Tùy chọn", IDC_STATIC, 10, 60, 220, 65
    AUTOCHECKBOX    "Đặt dấu theo chuẩn mới (oà, uỳ thay vì òa, ùy)", IDC_CHECK_MODERN, 20, 74, 200, 10
    AUTOCHECKBOX    "Kiểm tra chính tả & Gợi ý từ thông minh", IDC_CHECK_SPELL, 20, 90, 200, 10
    AUTOCHECKBOX    "Khởi động cùng Windows", IDC_CHECK_STARTUP, 20, 106, 200, 10

    DEFPUSHBUTTON   "Đồng ý", IDC_BTN_OK, 120, 135, 50, 14
    PUSHBUTTON      "Hủy", IDC_BTN_CANCEL, 175, 135, 50, 14
END

1 VERSIONINFO
FILEVERSION     0,3,0,0
PRODUCTVERSION  0,3,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GoTiengViet Open Source Project\0"
            VALUE "FileDescription", "GoTiengViet - Bộ gõ tiếng Việt Native\0"
            VALUE "FileVersion", "0.3.0.0\0"
            VALUE "InternalName", "gotiengviet\0"
            VALUE "LegalCopyright", "Copyright (C) 2026\0"
            VALUE "OriginalFilename", "gotiengviet.exe\0"
            VALUE "ProductName", "GoTiengViet\0"
            VALUE "ProductVersion", "0.3.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
