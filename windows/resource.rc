#include <windows.h>
#include <commctrl.h>
#include "resource.h"

/* The dialog strings below are UTF-8: tell windres (and rc.exe) to read
 * this file as UTF-8, otherwise Vietnamese text becomes mojibake when
 * the build machine uses another system codepage. */
#pragma code_page(65001)

#ifndef IDC_STATIC
#define IDC_STATIC (-1)
#endif

IDI_APP_ICON    ICON    "icons/gotiengviet.ico"
IDI_TRAY_V      ICON    "icons/tray_v.ico"
IDI_TRAY_E      ICON    "icons/tray_e.ico"

IDD_SETUP_DIALOG DIALOGEX 0, 0, 240, 225
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GoTiengViet - Setup"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    /* ASCII placeholders only: the real (Vietnamese) strings are set at
     * runtime in UTF-16, so no resource compiler codepage can mojibake
     * this dialog on any build machine or system locale. */
    GROUPBOX        "Input method", IDC_GROUP_TYPE, 10, 10, 220, 45
    AUTORADIOBUTTON "Telex", IDC_RADIO_TELEX, 20, 24, 190, 10, WS_GROUP
    AUTORADIOBUTTON "VNI", IDC_RADIO_VNI, 20, 38, 190, 10

    GROUPBOX        "Options", IDC_GROUP_OPTS, 10, 60, 220, 65
    AUTOCHECKBOX    "New tone-mark placement", IDC_CHECK_MODERN, 20, 74, 200, 10
    AUTOCHECKBOX    "Spellcheck and smart suggestions", IDC_CHECK_SPELL, 20, 90, 200, 10
    AUTOCHECKBOX    "Start with Windows", IDC_CHECK_STARTUP, 20, 106, 200, 10

    GROUPBOX        "AI suggestions (Ollama, optional)", IDC_GROUP_AI, 10, 130, 220, 60
    AUTOCHECKBOX    "Enable AI suggestions", IDC_CHECK_AI, 20, 144, 200, 10
    LTEXT           "Model:", IDC_LBL_MODEL, 20, 160, 40, 10
    EDITTEXT        IDC_EDIT_MODEL, 65, 158, 155, 12
    LTEXT           "URL:", IDC_LBL_URL, 20, 174, 40, 10
    EDITTEXT        IDC_EDIT_URL, 65, 172, 155, 12

    DEFPUSHBUTTON   "OK", IDC_BTN_OK, 120, 200, 50, 14
    PUSHBUTTON      "Cancel", IDC_BTN_CANCEL, 175, 200, 50, 14
    PUSHBUTTON      "Data", IDC_BTN_DATA, 55, 200, 60, 14
END

IDD_DATA_DIALOG DIALOGEX 0, 0, 280, 232
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GoTiengViet - Data"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    /* ASCII placeholders only: real strings are set at runtime in UTF-16. */
    AUTORADIOBUTTON "Macro", IDC_DATA_MACRO, 10, 10, 120, 10, WS_GROUP
    AUTORADIOBUTTON "Emoji", IDC_DATA_EMOJI, 135, 10, 120, 10
    LISTBOX         IDC_DATA_LIST, 10, 25, 260, 100, WS_VSCROLL | WS_BORDER | LBS_NOTIFY
    LTEXT           "Key:", IDC_LBL_KEY, 10, 132, 40, 10
    EDITTEXT        IDC_DATA_KEY, 55, 130, 215, 12
    LTEXT           "Value:", IDC_LBL_VALUE, 10, 147, 40, 10
    EDITTEXT        IDC_DATA_VALUE, 55, 145, 215, 12
    PUSHBUTTON      "Save", IDC_DATA_SAVE, 10, 165, 60, 14
    PUSHBUTTON      "Delete", IDC_DATA_DELETE, 75, 165, 60, 14
    PUSHBUTTON      "Folder", IDC_DATA_FOLDER, 140, 165, 65, 14
    PUSHBUTTON      "Close", IDC_DATA_CLOSE, 210, 165, 60, 14
    LTEXT           "Note", IDC_DATA_NOTE, 10, 188, 260, 36
END

1 VERSIONINFO
FILEVERSION     0,8,1,0
PRODUCTVERSION  0,8,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GoTiengViet Open Source Project\0"
            VALUE "FileDescription", "GoTiengViet - Vietnamese Input (Native)\0"
            VALUE "FileVersion", "0.8.1.0\0"
            VALUE "InternalName", "gotiengviet\0"
            VALUE "LegalCopyright", "Copyright (C) 2026\0"
            VALUE "OriginalFilename", "gotiengviet.exe\0"
            VALUE "ProductName", "GoTiengViet\0"
            VALUE "ProductVersion", "0.8.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
