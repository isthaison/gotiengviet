#include <windows.h>

/* Stub version: bump ONLY when windows/tsf/stub_loader.cpp or
 * windows/tsf/tsf_register.cpp change AND the installed base already
 * carries the previous payload. v1 already registers VI-only, so the
 * VI + drop-EN payload rides without a reboot (updates never re-run
 * regsvr32; cleanup runs in-app). Kept deliberately independent from
 * the app GTV_VERSION. */
#define GTV_STUB_VERSION "1"
#define GTV_STUB_VERSION_NUM 1,0,0,0

1 VERSIONINFO
FILEVERSION     GTV_STUB_VERSION_NUM
PRODUCTVERSION  GTV_STUB_VERSION_NUM
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x2L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GoTiengViet Open Source Project\0"
            VALUE "FileDescription", "GoTiengViet TSF stub (stable)\0"
            VALUE "FileVersion", GTV_STUB_VERSION ".0\0"
            VALUE "InternalName", "gtv_tsf\0"
            VALUE "LegalCopyright", "Copyright (C) 2026\0"
            VALUE "OriginalFilename", "gtv_tsf.dll\0"
            VALUE "ProductName", "GoTiengViet\0"
            VALUE "ProductVersion", GTV_STUB_VERSION ".0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
